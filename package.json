{
  "name": "pdfpuffin-core",
  "version": "1.0.0",
  "description": "Shared document schema and PDFKit renderer for PDF Puffin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "pdfkit": "^0.19.1"
  }
}
